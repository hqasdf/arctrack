# Copy to .env.local. Keep .env.local out of Git.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Use this same address in your browser and Supabase URL settings.
APP_URL=http://127.0.0.1:3000
# Server-only Supabase secret/service-role key for verified account deletion and Garmin storage.
# Never prefix with NEXT_PUBLIC_ or EXPO_PUBLIC_. Do not commit the real value.
SUPABASE_SECRET_KEY=

# Server-only Garmin account connection. Keep all real values out of Git.
# New authorizations are OFF by default; cleanup does not depend on this switch.
GARMIN_CONNECT_ENABLED=false
# Comma-separated approved Supabase Auth user UUIDs. Empty/malformed list denies all.
GARMIN_TEST_USER_IDS=
# Callback origin MUST equal APP_URL and be registered in the Garmin portal.
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
GARMIN_REDIRECT_URI=http://127.0.0.1:3000/api/integrations/garmin/callback
# Base64-encoded 32 random bytes; preserve this key while encrypted connections exist.
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
GARMIN_TOKEN_ENCRYPTION_KEY=

# OFF until the local health migration, documented notification verification and
# durable worker schedule are separately reviewed and activated. Server-only.
GARMIN_HEALTH_ENABLED=false
# Server-only scheduler secret, required by the internal worker (>=32 chars).
# Do not reuse the Garmin client secret or token-encryption key.
CRON_SECRET=

# Optional weather: disabled until local migration/configuration is approved.
ARC_TRACK_WEATHER_ENABLED=false
# development is allowed only with NODE_ENV=development; production requires commercial.
ARC_TRACK_WEATHER_MODE=development
OPEN_METEO_API_KEY=
