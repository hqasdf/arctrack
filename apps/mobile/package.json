{
  "name": "@arc-track/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": ["expo-secure-store"]
      }
    }
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "test:essential": "node --experimental-strip-types --test tests/auth-flow.test.mjs tests/auth-routing.test.mjs tests/auth-storage.test.mjs tests/session-authority.test.mjs tests/passkey-session-security.test.mjs tests/secure-store-android-patch.test.mjs tests/counter-responsive.test.mjs tests/arrow-owner.test.mjs tests/arrow-save-queue.test.mjs tests/native-target-gestures.test.mjs tests/scoring-state.test.mjs tests/guarded-writes.test.mjs tests/parity.test.mjs"
  },
  "dependencies": {
    "@arc-track/core": "*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "2.116.0",
    "expo": "~57.0.25",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.11",
    "expo-location": "~57.0.21",
    "expo-media-library": "~57.0.5",
    "expo-router": "~57.0.23",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.3.0",
    "react-native": "0.86.3",
    "react-native-passkey": "3.6.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "4.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
