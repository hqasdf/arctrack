{
  "name": "@arc-track/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-secure-store"
        ]
      }
    }
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "test:essential": "node --experimental-strip-types --test tests/auth-flow.test.mjs tests/auth-routing.test.mjs tests/auth-storage.test.mjs tests/session-authority.test.mjs tests/passkey-session-security.test.mjs tests/secure-store-android-patch.test.mjs tests/counter-responsive.test.mjs tests/arrow-owner.test.mjs tests/arrow-save-queue.test.mjs tests/native-target-gestures.test.mjs tests/scoring-state.test.mjs tests/guarded-writes.test.mjs tests/parity.test.mjs"
  },
  "dependencies": {
    "@arc-track/core": "*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "2.116.0",
    "expo": "~58.0.21",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.14",
    "expo-file-system": "~58.0.13",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.15",
    "expo-location": "~58.0.20",
    "expo-media-library": "~58.0.13",
    "expo-router": "~58.0.28",
    "expo-secure-store": "58.0.2",
    "expo-sharing": "~58.0.21",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-passkey": "3.6.2",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "4.0.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "~6.0.3"
  }
}
