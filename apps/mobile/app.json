{
  "expo": {
    "name": "Arc Track",
    "slug": "arc-track",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "arctrack",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.whqq.arctrack",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      ["expo-secure-store", { "faceIDPermission": false }]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dfd3b325-3579-49b1-bd3b-6e8c762993eb"
      }
    }
  }
}
