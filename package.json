{
  "name": "arc-track",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "node apps/mobile/scripts/patch-secure-store-android.mjs",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
    "lint:mobile": "eslint --config eslint.mobile.config.mjs apps/mobile/app apps/mobile/src --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:essential": "node --experimental-strip-types --test tests/auth-policy.test.mjs tests/account-deletion.test.mjs tests/garmin.test.mjs tests/garmin-health.test.mjs tests/arrow-counter.test.mjs tests/counter-reliability.test.mjs tests/scoring-replot.test.mjs",
    "test:maintenance": "node --experimental-strip-types --test tests/maintenance.test.mjs tests/counter-parity.test.mjs tests/architecture.test.mjs tests/garmin-ingress.test.mjs tests/performance-tooling.test.mjs tests/release-gate.test.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:workflow": "node scripts/check-workflow.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:maintenance": "npm run check:workflow && npm run check:architecture && npm run check:migrations && npm run test:maintenance",
    "report:build": "node scripts/performance-report.mjs",
    "test:performance": "node scripts/test-performance.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@arc-track/core": "*",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "next": "16.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "expo-router": "~58.0.28",
    "lighthouse": "13.6.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "yaml": "2.9.1"
  },
  "overrides": {
    "zod@4.6.5": "4.6.6",
    "eslint-plugin-react-hooks": {
      "zod": "4.6.6"
    }
  }
}
